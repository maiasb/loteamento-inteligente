{
  "name": "vale-dos-carajas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "next build && gh-pages -d out -t",
    "hostgator:deploy": "npm run build && pm2 restart vale-dos-carajas || pm2 start npm --name vale-dos-carajas -- start",
    "generate:excel": "node scripts/generate-excel-template.js",
    "migrate": "node scripts/migrate.js run",
    "migrate:prod": "node scripts/migrate-prod.js run",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:status:prod": "node scripts/migrate-prod.js status",
    "migrate:create": "node scripts/migrate.js create"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.19.3",
    "axios": "^1.13.2",
    "mysql2": "^3.15.3",
    "next": "16.0.1",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-pdf": "^10.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2"
  }
