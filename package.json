{
  "name": "vale-dos-carajas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "ts-node --transpile-only -O '{\"module\":\"commonjs\",\"moduleResolution\":\"node10\"}' scripts/migrate.ts",
    "seed:dev": "ts-node --transpile-only -O '{\"module\":\"commonjs\",\"moduleResolution\":\"node10\"}' scripts/seed-dev.ts"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.19.3",
    "axios": "^1.20.0",
    "cloudinary": "^2.9.0",
    "mysql2": "^3.24.6",
    "next": "16.4.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-pdf": "^10.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3"
  },
  "resolutions": {
    "canvas": "npm:empty-npm-package@1.0.0",
    "lodash": "^4.18.0",
    "source-map-js": "^1.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml}": [
      "prettier --write"
    ]
  }
}
